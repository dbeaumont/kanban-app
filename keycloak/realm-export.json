{
  "realm": "kanban-realm",
  "enabled": true,
  "clients": [
    {
      "clientId": "kanban-frontend",
      "publicClient": true,
      "redirectUris": ["http://localhost:4200/*", "http://localhost:8080/*"],
      "webOrigins": ["*"],
      "protocol": "openid-connect"
    },
    {
      "clientId": "kanban-bff",
      "secret": "bff-secret",
      "serviceAccountsEnabled": true,
      "redirectUris": ["http://localhost:8081/*"],
      "webOrigins": ["*"],
      "protocol": "openid-connect"
    }
  ],
  "roles": {
    "realm": [
      {"name": "ROLE_USER"},
      {"name": "ROLE_ADMIN"}
    ]
  },
  "users": [
    {
      "username": "demo",
      "enabled": true,
      "credentials": [{"type": "password", "value": "demo", "temporary": false}],
      "realmRoles": ["ROLE_USER"]
    }
  ]
}
